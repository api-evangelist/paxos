{
  "item": [
    {
      "id": "1eac961f-d699-4280-957d-10bdd6435625",
      "name": "Monitoring Addresses",
      "description": {
        "content": "A Monitoring Address is a blockchain address that Paxos monitors daily for eligible stablecoin activity and determines the amount of rewards your organization will earn. We recommend adding any addresses you expect to hold, receive, or mint Paxos stablecoins as a monitoring address in order to receive rewards for all of your qualifying on-chain activity. \n\n> Monitoring addresses must be added by month end (`23:59 UTC+0`) in order to earn rewards for that month. Addresses added after month end will start earning rewards for the following month.\n\n*These endpoints are only relevant for Global Dollar Network (GDN) partners.*\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "680f2aad-482b-4666-8d79-1b6ed1f67565",
          "name": "List Monitoring Address",
          "request": {
            "name": "List Monitoring Address",
            "description": {
              "content": "Retrieve a list of monitoring address\n\nFilter by network to retrieve a list of addresses on that network, or filter by network & address to retrieve a single record.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rewards",
                "monitor",
                "address"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "On-chain address Paxos is monitoring for eligible reward activity. Must be valid for the specified network.\nFor `SOLANA` specify the wallet account (ie: not a derived/token account like an ATA)."
                },
                {
                  "disabled": false,
                  "key": "crypto_network",
                  "value": "<string>",
                  "description": "Network the address belongs to. Supported: `ETHEREUM`, `SOLANA`, `INK`, `XLAYER`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results to return. Defaults to `100` if no limit is provided. Maximum `1000`."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Results are ordered by `created_at`. Specify the ordering of the results. Defaults to `DESC`."
                },
                {
                  "disabled": false,
                  "key": "page_cursor",
                  "value": "<string>",
                  "description": "Cursor for pagination"
                }
              ],
              "variable": []
            },
            "header": [
