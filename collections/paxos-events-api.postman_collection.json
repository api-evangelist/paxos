{
  "item": [
    {
      "id": "77e6d60e-b885-4fe1-b2f9-06ff821fe9df",
      "name": "Events",
      "description": {
        "content": "The Events API allows you to fetch events that occurred on the Paxos platform with the full event payload. This REST API can be used as part of your webhook integrations (including rebuilding your event history should your webhook consumer exceed its retries), or standalone by polling for events related to your identities.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b0ab2565-dbf0-4f86-ae70-e374717bd892",
          "name": "List Events",
          "request": {
            "name": "List Events",
            "description": {
              "content": "This endpoint enables you to fetch a list of events that have been created by the system.\nYou can use query parameters to filter the results by the `created_at` time using `created_at.lt`, `created_at.gt`, etc. and you can\n`limit` the number of events returned.\n\nUse `page_cursor` from the previous response to paginate through results. Use `order` to control sort direction (ASC or DESC by created_at).\nEvents returned will be ordered by `created_at` in ascending order by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created_at.lt",
                  "value": "<dateTime>",
                  "description": "Include timestamps strictly less than lt. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.lte",
                  "value": "<dateTime>",
                  "description": "Include timestamps less than or equal to lte. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.eq",
                  "value": "<dateTime>",
                  "description": "Include timestamps exactly equal to eq. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.gte",
                  "value": "<dateTime>",
                  "description": "Include timestamps greater than or equal to gte. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.gt",
                  "value": "<dateTime>",
                  "description": "Include timestamps strictly greater than gt. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results to return. Defaults to 100 if no limit is provided."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Retrieve all (default) or optionally filter by event type."
                },
                {
                  "disabled": false,
                  "key": "is_test",
                  "value": "<boolean>",
                  "description": "Filter for test events (true) or real events (false). Defaults to false (real events only)."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order for results by created_at. Defaults to ASC (oldest first)."
                },
                {
                  "disabled": false,
                  "key": "page_cursor",
                  "value": "<string>",
                  "description": "Cursor from a previous response to fetch the next page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "conversion:read_conversion_stablecoin conversion:write_conversion_stablecoin exchange:historical_prices exchange:read_order exchange:read_quote exchange:read_quote_execution exchange:write_quote_execution exchange:write_order fee:write_crypto_withdrawal_fee funding:read_bank_balance funding:read_profile funding:write_profile identity:read_account identity:read_identity identity:write_account identity:write_identity settlement:read_transaction settlement:write_transaction tax:read_tax_form tax:read_tax_lot tax:write_tax_lot transfer:read_deposit_address transfer:read_fiat_account transfer:read_fiat_deposit_instructions transfer:read_transfer transfer:read_transfer_limit transfer:reject_crypto_deposit transfer:update_crypto_deposit transfer:write_crypto_withdrawal transfer:write_deposit_address transfer:write_fiat_account transfer:write_fiat_deposit_instructions transfer:write_internal_transfer transfer:write_sandbox_fiat_deposit transfer:write_fiat_withdrawal events:read_event"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth.paxos.com/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
