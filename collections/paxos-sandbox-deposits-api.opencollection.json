{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Sandbox Deposits API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Sandbox Deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Sandbox Deposit",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paxos.com/v2/sandbox/profiles/:profile_id/deposit",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path",
                "description": "The ID of the profile that will credited with the assets."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a test deposit to fund a profile in the sandbox environment.\n\nAlways specify `crypto_network` when making a crypto sandbox deposit. Omit the parameter when depositing fiat.\n\n*This functionality is only available in the sandbox environment.*"
        }
      ]
    }
  ],
  "bundled": true
}