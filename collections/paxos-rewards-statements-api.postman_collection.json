          "id": "65495cf5-f239-48a3-b5fa-54c0d03ea82d",
          "name": "List Rewards Statements",
          "request": {
            "name": "List Rewards Statements",
            "description": {
              "content": "Returns monthly rewards statements for the authenticated partner, ordered by\nperiod newest first. Summary fields (total_accrued, avg_daily_balance) are\nincluded in list responses. Presigned download URLs are populated on files\nfor completed statements only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rewards",
                "statements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of statements to return. Defaults to 12 if not set."
                },
                {
                  "disabled": false,
                  "key": "page_cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor from a previous response."
                },
                {
                  "disabled": false,
                  "key": "asset_type",
                  "value": "<string>",
                  "description": "When set, only statements for this asset type are returned."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "When set, only statements of this content type are returned.\n\n - STATEMENT_TYPE_MONTHLY_REWARDS: Monthly statement: PDF rewards summary with daily balance totals, rates, and\nper-payout-group breakdown, plus a CSV per-wallet daily balance export."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "conversion:read_conversion_stablecoin conversion:write_conversion_stablecoin exchange:historical_prices exchange:read_order exchange:read_quote exchange:read_quote_execution exchange:write_quote_execution exchange:write_order fee:write_crypto_withdrawal_fee funding:read_bank_balance funding:read_profile funding:write_profile identity:read_account identity:read_identity identity:write_account identity:write_identity settlement:read_transaction settlement:write_transaction tax:read_tax_form tax:read_tax_lot tax:write_tax_lot transfer:read_deposit_address transfer:read_fiat_account transfer:read_fiat_deposit_instructions transfer:read_transfer transfer:read_transfer_limit transfer:reject_crypto_deposit transfer:update_crypto_deposit transfer:write_crypto_withdrawal transfer:write_deposit_address transfer:write_fiat_account transfer:write_fiat_deposit_instructions transfer:write_internal_transfer transfer:write_sandbox_fiat_deposit transfer:write_fiat_withdrawal events:read_event"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth.paxos.com/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
