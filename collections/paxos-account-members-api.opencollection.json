{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Account Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Account Members",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paxos.com/v2/identity/account-members",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Add one or more account members to a given account.\n\nThe account members added by this API do not affect existing account members. For example,\nif an account has two members, and one member is added using this API, then the account will\nend up with three members.\n\nFor more information on properties of account members, see [Account Members](#account-members)."
        },
        {
          "info": {
            "name": "Remove Account Member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.paxos.com/v2/identity/account-members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The account member ID that should be removed from the account."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Removes an account member from an account."
        }
      ]
    }
  ],
  "bundled": true
}