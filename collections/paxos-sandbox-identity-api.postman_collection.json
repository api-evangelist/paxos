          "name": "Sandbox Set Identity Status",
          "request": {
            "name": "Sandbox Set Identity Status",
            "description": {
              "content": "Set the various statuses for the given Identity. To enable the Person Identity to transact,\nset both `id_verification_status` and `sanctions_verification_status` to `\"APPROVED\"`.\nTo enable the Institution to transact, set both `sanctions_verification_status` to `\"APPROVED\"`.\nThis endpoint also allows you to set the statuses for `document_verification_status` and\n`additional_screening_status`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "identity",
                "identities",
                ":id",
