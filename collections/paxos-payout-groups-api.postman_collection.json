      "id": "2358fef0-f1c3-4b10-b7b7-04c39800a5bb",
      "name": "Payout Groups",
      "description": {
        "content": "Payout groups encapsulate common rewards characteristics. All monitored addresses that reference a payout group accumulate rewards at the same rate and claim to the payout destination specified for that group.\n\n*These endpoints are only relevant for whitelisted Rewards partners.*\n",
        "type": "text/plain"
      },
