{
  "item": [
    {
      "id": "7431444b-b77a-4c4a-8ee6-d1b24701f083",
      "name": "Profiles",
      "description": {
        "content": "Profiles hold asset balances, and every Paxos transaction is on a particular profile.\nDepending on your integration type, Profiles may be used to reflect both corporate balances or individual user balances.\nThere are two types of Profiles:\n- `DEFAULT` Profiles are system-generated.\n- `NORMAL` Profiles are created using the [Create Profile](#operation/CreateProfile) endpoint and are the only type of Profile you can create.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "99314a3f-0e2d-4d85-b806-f7f86fea4433",
          "name": "List Profiles",
          "request": {
            "name": "List Profiles",
            "description": {
              "content": "Return the associated Profiles for the current Account.\nThe paginated results default to the maximum limit of 1,000 Profiles, unless otherwise specified with the `limit` parameter.\nEvery paginated response contains a `next_page` field until the last page is reached.\nPass the `next_page` value into the `page_cursor` field of the next request to retrieve the next page of results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profiles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created_at.lt",
                  "value": "<dateTime>",
                  "description": "Include timestamps strictly less than lt. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.lte",
                  "value": "<dateTime>",
                  "description": "Include timestamps less than or equal to lte. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.eq",
                  "value": "<dateTime>",
                  "description": "Include timestamps exactly equal to eq. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.gte",
                  "value": "<dateTime>",
                  "description": "Include timestamps greater than or equal to gte. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "created_at.gt",
                  "value": "<dateTime>",
                  "description": "Include timestamps strictly greater than gt. RFC3339 format, like `2006-01-02T15:04:05Z`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results to return."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Return items in ascending (ASC) or descending (DESC) order. Defaults to ASC."
                },
                {
                  "disabled": false,
                  "key": "order_by",
                  "value": "<string>",
                  "description": "The specific method by which the returned results will be ordered."
                },
                {
                  "disabled": false,
                  "key": "page_cursor",
                  "value": "<string>",
                  "description": "Cursor token for fetching the next page."
                },
                {
                  "disabled": false,
                  "key": "nickname",
                  "value": "<string>",
                  "description": "Optionally filter by Profile display name. Retrieves nickname(s) based on the beginning characters of the given display name (prefix matching). Case insensitive. WIldcards and regular expressions not supported."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Optionally filter by the UUIDs of the profiles. Limit 100."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Optionally filter by the UUIDs of the profiles. Limit 100."
                }
              ],
