{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Paxos Transfers API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Paxos Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Paxos Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paxos.com/v2/transfer/paxos",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Transfer assets between two Profiles belonging to different [Entities](https://docs.paxos.com/dashboard/organization#entity)."
        }
      ]
    }
  ],
  "bundled": true
}