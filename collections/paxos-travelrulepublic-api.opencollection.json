{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members TravelRulePublic API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "TravelRulePublic",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ListVasps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/travelrule/vasps",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Optionally filter by the vasps' IDs."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Defaults to 100 if no limit is provided."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Determines whether the items are returned in ascending (ASC), or descending (DESC) order."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The specific method by which the returned results will be ordered."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Optional: Cursor for getting the next page of results. When the number of items returned is fewer\nthan the limit, there is currently no next page."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Optional: case-insensitive prefix match on the VASP name, for type-ahead lookup."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          }
        },
        {
          "info": {
            "name": "GetVasp",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/travelrule/vasps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique Paxos identifier of the VASP to retrieve."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}