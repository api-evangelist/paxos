{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Statements API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Statements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Statements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/statements",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "query",
                "description": "customer_id is a required field."
              },
              {
                "name": "ref_ids",
                "value": "",
                "type": "query",
                "description": "Optionally filter by the ref_ids of the statements."
              },
              {
                "name": "statement_ids",
                "value": "",
                "type": "query",
                "description": "Optionally filter by the ids of the statements."
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query",
                "description": "Optionally filter by the statuses of the statements to be returned. Defaults to all statuses."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Defaults to 100."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order for the results by period start, defaults to DESC if not provided."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for getting the next page of results."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List statements based on the provided filters"
        }
      ]
    }
  ],
  "bundled": true
}