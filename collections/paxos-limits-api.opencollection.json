{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Limits API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Limits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Transfer Limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/transfer/limits/utilizations",
            "params": [
              {
                "name": "transfer_type",
                "value": "",
                "type": "query",
                "description": "Type of transfer to fetch limits for."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List all limits that apply to the given transaction type."
        }
      ]
    }
  ],
  "bundled": true
}