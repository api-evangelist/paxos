{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Claims API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Claims",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List claim schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/rewards/claim-schedules",
            "params": [
              {
                "name": "payout_group_id",
                "value": "",
                "type": "query",
                "description": "Optionally filter by payout_group"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Defaults to 100. Maximum 1000."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Optional: Cursor for getting the next page of results."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a paginated list of claim schedules"
        },
        {
          "info": {
            "name": "Create a claim schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paxos.com/v2/rewards/claim-schedules",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new claim schedule for automatic reward claims"
        },
        {
          "info": {
            "name": "Update a claim schedule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.paxos.com/v2/rewards/claim-schedules/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Updates an existing claim schedule"
        },
        {
          "info": {
            "name": "Delete a claim schedule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.paxos.com/v2/rewards/claim-schedules/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Deletes a claim schedule"
        },
        {
          "info": {
            "name": "List claims",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/rewards/claims",
            "params": [
              {
                "name": "payout_group_id",
                "value": "",
                "type": "query",
                "description": "Optional filters"
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query"
              },
              {
                "name": "chain",
                "value": "",
                "type": "query"
              },
              {
                "name": "jurisdiction",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_time",
                "value": "",
                "type": "query",
                "description": "Start and end times - Inclusive"
              },
              {
                "name": "end_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "asset_type",
                "value": "",
                "type": "query",
                "description": "When set, only claims for this asset type (e.g. \"USDG\", \"PYUSD\") are returned."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Pagination"
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a paginated list of claims with optional filtering"
        }
      ]
    }
  ],
  "bundled": true
}