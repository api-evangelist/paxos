          "name": "Create Paxos Transfer",
          "request": {
            "name": "Create Paxos Transfer",
            "description": {
              "content": "Transfer assets between two Profiles belonging to different [Entities](https://docs.paxos.com/dashboard/organization#entity).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transfer",
                "paxos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
