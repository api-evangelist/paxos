{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paxos Account Members Payments API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paxos.com/v2/statements/payments",
            "params": [
              {
                "name": "ref_ids",
                "value": "",
                "type": "query",
                "description": "No other parameters are allowed if ref_ids are provided"
              },
              {
                "name": "payment_ids",
                "value": "",
                "type": "query",
                "description": "No other parameters are allowed if payment_ids are provided"
              },
              {
                "name": "customer_id",
                "value": "",
                "type": "query",
                "description": "Use together with product to list for a specific customer and product"
              },
              {
                "name": "product",
                "value": "",
                "type": "query",
                "description": "Use together with product to list for a specific customer and product"
              },
              {
                "name": "payment_status",
                "value": "",
                "type": "query",
                "description": "Optional, filter by payment status"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Defaults to 100 if no limit is provided."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order for the results by created at, defaults to DESC if not provided."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for getting the next page of results."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.paxos.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List payments based on the provided filters"
        }
      ]
    }
  ],
  "bundled": true
}