          "name": "Document Upload",
          "request": {
            "name": "Document Upload",
            "description": {
              "content": "This endpoint enables you to receive a URL to upload a document to Paxos for identity verification or enhanced due diligence purposes.\nWhen uploading a document you must specify the document type. You will receive a\nURL where you can upload the document using a POST request.\n\nRequirements:\n- Uploaded documents must be less than 100 MB in size\n- Supported formats include PDF, JPG, and PNG\n\nFor more information on document requirements for enhanced due diligence, see [here](https://docs.paxos.com/identity/edd).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "identity",
                "identities",
                ":identity_id",
                "documents"
              ],
              "host": [
